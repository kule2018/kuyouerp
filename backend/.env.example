# ===== 数据库 (MySQL) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=kuyou
DB_SYNCHRONIZE=false

# ===== JWT =====
JWT_SECRET=kuyou-nestjs-rebuild-secret
JWT_EXPIRES_IN=7200

# ===== 服务端口 =====
PORT=3000

# ===== 默认 AI 模型配置（OpenAI 兼容接口，可指向 DeepSeek / OpenRouter / 本地 vLLM 等）=====
AI_DEFAULT_BASE_URL=https://api.deepseek.com/v1
AI_DEFAULT_API_KEY=sk-xxxx
AI_DEFAULT_MODEL=deepseek-chat
AI_DEFAULT_TEMPERATURE=0.7
AI_DEFAULT_MAX_TOKENS=2048
